AI_API_KEY=your-google-ai-studio-key
AI_MODEL=gemini-2.5-flash
# Chave gratis da Tavily (opcional; sem ela os especialistas nao pesquisam): https://tavily.com
WEB_SEARCH_API_KEY=your-tavily-api-key
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
# Codigo de acesso (obrigatorio ao publicar na internet; protege sua chave de IA)
ACCESS_CODE=change-me
